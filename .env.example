# ─────────────────────────────────────────────────────────────
# TruthLens AI 2.0 — Environment Configuration Template
# Copy this file to .env and fill in your credentials:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux / Mac)
# ─────────────────────────────────────────────────────────────

# ─── Google Gemini API (Required for live multi-agent LLM reasoning)
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash


# ─── Google Custom Search API (Optional — for broader live web RAG)
# Get key & CSE ID from: https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# ─── HuggingFace Token (Optional — for custom embedding models)
HF_TOKEN=

# ─── Database Configuration
DATABASE_PATH=truthlens.db
